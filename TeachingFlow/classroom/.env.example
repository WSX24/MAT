# ============================================================================
# 本机实测配置（由 .env.example 复制而来）
# 你这台机器上可用的本地模型：
#   ds-ins:latest                      3.8GB  —— deepseek instruct，日常问答够用
#   qwen3.5:9b                         6.1GB  —— 中文更稳，建议课堂用这个
#   deepseek-coder:6.7b-instruct       3.8GB  —— 偏代码
# 切换模型只改 OLLAMA_MODEL 一行即可。
# ============================================================================

LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama（本地，零成本）
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=ds-ins:latest 

# ---------------------------------------------------------------------------
# OpenCode Zen（需要 API Key 才会启用）
# ---------------------------------------------------------------------------
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# DeepSeek（与 TeachingFlow 共用仓库根那份 key：PPT-Agent/.env）
#   课堂启动时会**补缺地**再读一遍 <仓库根>/PPT-Agent/.env（已存在的环境变量不覆盖），
#   所以真要换到 DeepSeek，这里只要把上面的 LLM_PROVIDER 改成 deepseek，
#   下面三行留空即可。默认仍是 ollama —— 本机有模型时不该凭空产生一次付费调用。
# ---------------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# 可选：这家服务商认不认 reasoning_effort。留空 / off = 请求体里不带它
# （DeepSeek 的 chat 接口不认这个参数，多塞一个字段只会换来 400）
DEEPSEEK_THINKING_STYLE=off

# ---------------------------------------------------------------------------
# 生成参数
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=180

# ---------------------------------------------------------------------------
# 语音（edge-tts，免费在线 TTS；失败自动降级为纯文字）
# ---------------------------------------------------------------------------
TTS_ENABLED=1
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=+0%

# ---------------------------------------------------------------------------
# 课堂参数（§8 待验证清单 V1~V6 的设计假设）
# ---------------------------------------------------------------------------
CLASSROOM_PROBE_WINDOW=12
CLASSROOM_MAX_CLARIFY_ASKS=2
CLASSROOM_MAX_REPHRASE=4
CLASSROOM_UNIT_CHAR_WARN=250

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# 接入真实 PPT（README §9）
#   留空 = 用原型自带的手写演示课件；填了 = 用 decks/<DECK_ID>/ 里的真实课件。
#   deck_id 就是 decks/ 下的目录名（`python run.py decks` 可列出来）。
# ---------------------------------------------------------------------------
DECK_ID=Unit_2_Sweet_Home单词解析课件_2025_2026学年人教版_2024_八年级英

# --- 由 GUI 服务商面板写入 ---
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=
OPENCODE_GO_API_KEY=

# --- 由 GUI 服务商面板写入 ---
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_API_KEY=